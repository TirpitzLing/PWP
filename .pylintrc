[MASTER]
ignore=venv,instance,.pytest_cache,__pycache__,tests

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    broad-except,
    no-self-use,
    fixme,
    duplicate-code

[FORMAT]
max-line-length=79

[DESIGN]
max-args=8
